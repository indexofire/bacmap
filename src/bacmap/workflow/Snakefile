# bacmap 端到端分析流程：物种由 gside 鉴定（species_identify），
# 分型/血清型/SNP/cgMLST 等按病原注册表（core/pathogens.yaml）路由。

import os
import pandas as pd
from pathlib import Path

from bacmap.core.tool_selection import load_selection

configfile: str(Path(workflow.basedir) / "config" / "config.yaml")

PROJECT_ROOT = Path(config["project_root"]).resolve()
WORKDIR = PROJECT_ROOT / config["workdir"]
_SAMPLES_FILE = Path(config["samples_file"])
if not _SAMPLES_FILE.is_absolute():
    _SAMPLES_FILE = Path(workflow.basedir) / _SAMPLES_FILE
SAMPLES_DF = pd.read_csv(_SAMPLES_FILE, sep="\t").set_index("sample")
SAMPLES = SAMPLES_DF.index.tolist()


def _tool_selection_path() -> Path:
    """用户/项目覆盖：config 显式路径 → 新/旧环境变量 → BACMAP_HOME/config。

    新文件 ``tool_selection.yaml`` 优先；旧的 ``db_selection.yaml`` 仍被读取
    （gspec-only，加载时自动翻译）。
    """
    raw = str(
        config.get("tool_selection") or config.get("db_selection") or ""
    ).strip()
    if raw:
        path = Path(raw).expanduser()
        return path if path.is_absolute() else PROJECT_ROOT / path
    for env_name in ("BACMAP_TOOL_SELECTION", "BACMAP_DB_SELECTION"):
        env_value = os.environ.get(env_name, "").strip()
        if env_value:
            return Path(env_value).expanduser()
    for name in ("tool_selection.yaml", "db_selection.yaml"):
        candidate = PROJECT_ROOT / "config" / name
        if candidate.is_file():
            return candidate
    return PROJECT_ROOT / "config" / "tool_selection.yaml"


TOOL_SELECTION_PATH = _tool_selection_path()
TOOL_SELECTION = load_selection(TOOL_SELECTION_PATH)


def _col(sample: str, col: str) -> str:
    """samples.tsv 单元格取值（列缺失/空/NaN 归一为空串）。"""
    if col not in SAMPLES_DF.columns:
        return ""
    v = SAMPLES_DF.loc[sample, col]
    if v is None or str(v) == "nan":
        return ""
    return str(v).strip()


# 输入形态分支（v1.4.33）：reads 样本走 fastp→shovill；assembly 直入样本
# （已组装 FASTA，samples.tsv 的 assembly 列）跳过 QC/组装，直接进 contigs 通道。
READS_SAMPLES = [s for s in SAMPLES if _col(s, "R1") and _col(s, "R2")]
FASTA_SAMPLES = [s for s in SAMPLES if _col(s, "assembly") and s not in READS_SAMPLES]
# v1.4.42（PLAN #4）长读入口：longread 列有值的样本
LONGREAD_SAMPLES = [s for s in SAMPLES if _col(s, "longread") and s not in FASTA_SAMPLES]
# 混合组装：同时有短读 (R1/R2) 和长读 (longread) 的样本
HYBRID_SAMPLES = [s for s in SAMPLES if s in READS_SAMPLES and s in LONGREAD_SAMPLES]
# 纯长读：只有 longread、无 R1/R2 的样本
LONG_ONLY_SAMPLES = [s for s in LONGREAD_SAMPLES if s not in READS_SAMPLES]
_NO_INPUT = [
    s for s in SAMPLES
    if s not in READS_SAMPLES and s not in FASTA_SAMPLES and s not in LONGREAD_SAMPLES
]
if _NO_INPUT:
    raise ValueError(
        "samples.tsv 输入不完整（R1/R2 或 assembly 至少其一）: " + ", ".join(_NO_INPUT)
    )

def _sample_input_path(wc, column):
    value = SAMPLES_DF.loc[wc.sample, column]
    if value is None or str(value) == "nan" or not str(value).strip():
        raise ValueError(
            f"样本 {wc.sample} 在 samples.tsv 中没有 {column}；该规则只适用于 reads 样本"
        )
    return str(PROJECT_ROOT / value)

def r1_path(wc):
    return _sample_input_path(wc, "R1")

def r2_path(wc):
    return _sample_input_path(wc, "R2")

def assembly_path(wc):
    return str(PROJECT_ROOT / SAMPLES_DF.loc[wc.sample, "assembly"])

