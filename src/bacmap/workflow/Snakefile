# Hermes-bacmap 端到端分析流程（4 病原通用，物种自动路由）
# project.md §7.1 核心 pipeline

import pandas as pd
from pathlib import Path

configfile: str(Path(workflow.basedir) / "config" / "config.yaml")

PROJECT_ROOT = Path(config["project_root"]).resolve()
WORKDIR = PROJECT_ROOT / config["workdir"]
_SAMPLES_FILE = Path(config["samples_file"])
if not _SAMPLES_FILE.is_absolute():
    _SAMPLES_FILE = Path(workflow.basedir) / _SAMPLES_FILE
SAMPLES_DF = pd.read_csv(_SAMPLES_FILE, sep="\t").set_index("sample")
SAMPLES = SAMPLES_DF.index.tolist()

def r1_path(wc):
    return str(PROJECT_ROOT / SAMPLES_DF.loc[wc.sample, "R1"])

def r2_path(wc):
    return str(PROJECT_ROOT / SAMPLES_DF.loc[wc.sample, "R2"])

include: "rules/qc.smk"
include: "rules/assembly.smk"
include: "rules/species.smk"
include: "rules/typing_amr.smk"
include: "rules/dec_shigella.smk"
include: "rules/vpara.smk"
include: "rules/snp.smk"
include: "rules/cgmlst.smk"
include: "rules/taxonomy.smk"
include: "rules/annotation.smk"
include: "rules/report.smk"

# species-id plan A/B/C/D gating: alternate identification methods add their
# outputs only when the matching database is installed; missing databases
# degrade to the marker-only baseline with a warning instead of failing.
import os as _os

_ALT_DB_BY_MODE = {
    "panel": "refseq_panel",
    "skani_gtdb": "skani_gtdb",
    "mash_refseq": "mash_refseq",
    "sourmash": "sourmash_gtdb",
}
_ALT_TARGET_BY_MODE = {
    "panel": "species/species_ani.json",
    "skani_gtdb": "species/species_ani.json",
    "mash_refseq": "species/species_ani.json",
    "sourmash": "species/species_sourmash.json",
}
_SPECIES_MODE = config.get("species_mode", "simple")
_ALT_ACTIVE = (
    _SPECIES_MODE in _ALT_DB_BY_MODE
    and (PROJECT_ROOT / "data" / "db" / _ALT_DB_BY_MODE[_SPECIES_MODE]).is_dir()
)
if _SPECIES_MODE in _ALT_DB_BY_MODE and not _ALT_ACTIVE:
    print(
        f"WARNING: species_mode={_SPECIES_MODE} but its database is not installed "
        f"(data/db/{_ALT_DB_BY_MODE[_SPECIES_MODE]}); degrading to marker-only. "
        "Run scripts/setup_databases.py to install."
    )

_STANDARD_ACTIVE = (
    _SPECIES_MODE == "standard"
    and bool(_os.environ.get("GTDBTK_DATA_PATH") or _os.environ.get("GTDBDB"))
)
if _SPECIES_MODE == "standard" and not _STANDARD_ACTIVE:
    print(
        "WARNING: species_mode=standard but GTDBTK_DATA_PATH is not set; "
        "GTDB-Tk validation will be skipped (marker-only). "
        "Run scripts/download_db_gtdbtk.py to install."
    )

_KRAKEN2_ACTIVE = bool(config.get("kraken2_prefilter", False)) and (
    PROJECT_ROOT / "data" / "db" / "kraken2_custom"
).is_dir()
if bool(config.get("kraken2_prefilter", False)) and not _KRAKEN2_ACTIVE:
    print(
        "WARNING: kraken2_prefilter enabled but data/db/kraken2_custom is not "
        "installed; raw reads go straight to fastp. Run scripts/setup_databases.py."
    )

_EXTRA_TARGETS = []
if _ALT_ACTIVE:
    _EXTRA_TARGETS += expand(
        str(WORKDIR) + "/{sample}/" + _ALT_TARGET_BY_MODE[_SPECIES_MODE], sample=SAMPLES
    )
if _STANDARD_ACTIVE:
    _EXTRA_TARGETS += expand(
        str(WORKDIR) + "/{sample}/taxonomy/validation.json", sample=SAMPLES
    )
if _KRAKEN2_ACTIVE:
    _EXTRA_TARGETS += expand(
        str(WORKDIR) + "/{sample}/kraken2/kraken2_prefilter.json", sample=SAMPLES
    )

rule all:
    input:
        expand(str(WORKDIR) + "/{sample}/report/{sample}_summary.json", sample=SAMPLES),
        expand(str(WORKDIR) + "/{sample}/annotation/annotation.json", sample=SAMPLES),
        expand(str(WORKDIR) + "/{sample}/vpa/vpa_serotype.json", sample=SAMPLES),
