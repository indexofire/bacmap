# bacmap 端到端分析流程：物种由 gside 鉴定（species_identify），
# 分型/血清型/SNP/cgMLST 等按病原注册表（core/pathogens.yaml）路由。

import pandas as pd
from pathlib import Path

configfile: str(Path(workflow.basedir) / "config" / "config.yaml")

PROJECT_ROOT = Path(config["project_root"]).resolve()
WORKDIR = PROJECT_ROOT / config["workdir"]
_SAMPLES_FILE = Path(config["samples_file"])
if not _SAMPLES_FILE.is_absolute():
    _SAMPLES_FILE = Path(workflow.basedir) / _SAMPLES_FILE
SAMPLES_DF = pd.read_csv(_SAMPLES_FILE, sep="\t").set_index("sample")
SAMPLES = SAMPLES_DF.index.tolist()

def r1_path(wc):
    return str(PROJECT_ROOT / SAMPLES_DF.loc[wc.sample, "R1"])

def r2_path(wc):
    return str(PROJECT_ROOT / SAMPLES_DF.loc[wc.sample, "R2"])

include: "rules/qc.smk"
include: "rules/assembly.smk"
include: "rules/species.smk"
include: "rules/typing_amr.smk"
include: "rules/gapit_typing.smk"
include: "rules/dec_shigella.smk"
include: "rules/vpara.smk"
include: "rules/snp.smk"
include: "rules/recombination.smk"
include: "rules/cgmlst.smk"
include: "rules/annotation.smk"
include: "rules/report.smk"

# reads 级 kraken2 预筛按需启用（与物种鉴定档位无关）。
_KRAKEN2_ACTIVE = bool(config.get("kraken2_prefilter", False)) and (
    PROJECT_ROOT / "data" / "db" / "kraken2_custom"
).is_dir()
if bool(config.get("kraken2_prefilter", False)) and not _KRAKEN2_ACTIVE:
    print(
        "WARNING: kraken2_prefilter enabled but data/db/kraken2_custom is not "
        "installed; raw reads go straight to fastp. Run scripts/setup_databases.py."
    )

# 物种/分类学鉴定整体由 gside 承担（species_identify 规则，含多法仲裁），
# 不再需要按鉴定档位追加 species_ani/species_sourmash/taxonomy 等占位目标。
_EXTRA_TARGETS = []
if _KRAKEN2_ACTIVE:
    _EXTRA_TARGETS += expand(
        str(WORKDIR) + "/{sample}/kraken2/kraken2_prefilter.json", sample=SAMPLES
    )

